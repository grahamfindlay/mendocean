# Browser-safe Supabase configuration. Never put service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_TELEMETRY_ENABLED=false
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Build-only secrets belong in Cloudflare's secret store, never VITE_ variables:
# POSTHOG_CLI_API_KEY, POSTHOG_CLI_PROJECT_ID, POSTHOG_CLI_HOST=https://us.posthog.com
# Development-only fixture preview is explicitly requested with ?preview=1.
