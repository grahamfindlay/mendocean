{
  "name": "mendocean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --config playwright.admin.config.ts",
    "test:db": "vitest run tests/database.test.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.tools.json",
    "test:stack": "node scripts/test-stack.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e:full": "playwright test --config playwright.full.config.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:updates": "playwright test --config playwright.updates.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.45.0",
    "posthog-js": "^1.436.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "suncalc": "^2.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@posthog/cli": "^0.18.9",
    "@types/node": "^22.20.2",
    "@types/pg": "8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pg": "8.16.3",
    "prettier": "^3.9.6",
    "supabase": "2.117.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
