# Server secrets only. Copy to an ignored .env file or set in Supabase.
APP_URL=https://your-app.pages.dev
ALLOWED_ORIGINS=https://your-app.pages.dev,http://localhost:5173,http://127.0.0.1:5173
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.
# 32 random bytes, base64-encoded. Save a recovery copy outside Supabase.
BHC_ENCRYPTION_KEY=
# A separate random secret used by Cron and private CI jobs.
JOBS_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
